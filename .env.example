# Copy this file to .env and fill in real values. .env is gitignored — never commit real tokens.

# GitHub Personal Access Token. Used as a fallback when the scan form is submitted
# without a PAT (api/analyze.php). Never stored in the database.
GITHUB_TOKEN=

# Database connection (defaults match config/database.php if left unset).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=repo_analyzer
DB_USER=root
DB_PASSWORD=
